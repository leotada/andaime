name "vela-pg"
description "Cooperative (fiber-based) PostgreSQL driver for vela, over asynchronous libpq loaded via dlopen. A separate package: the core does not depend on it."
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "vela:engine" path="../.."

toolchainRequirements dmd=">=2.109.1" ldc=">=1.40.1" gdc="no"
