name "pg"
description "Cooperative (fiber-based) PostgreSQL driver for andaime, over asynchronous libpq loaded via dlopen. A separate subpackage: the core does not depend on it."
authors "Leonardo Tada Antunes"
copyright "Copyright © 2026, leotada"
license "MIT"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "andaime:engine" version="*"

toolchainRequirements dmd=">=2.112.0" ldc=">=1.42.0" gdc="no"
