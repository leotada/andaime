name "pgjobs"
description "Postgres job queue for andaime: SKIP LOCKED claims, LISTEN/NOTIFY, a lease reaper and one cron slot across processes. A separate subpackage: the core does not depend on it."
authors "Leonardo Tada Antunes"
copyright "Copyright © 2026, leotada"
license "MIT"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "andaime:jobs" version="*"
dependency "andaime:pg" version="*"

toolchainRequirements dmd=">=2.109.1" ldc=">=1.40.1" gdc="no"
