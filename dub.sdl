name "andaime"
description "Micro web framework in D: FastAPI-style ergonomics, dispatch generated at compile time"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "andaime:http" version="*"
dependency "andaime:web" version="*"
dependency "andaime:engine" version="*"
subPackage "http"
subPackage "web"
subPackage "engine"
subPackage "jobs"
subPackage "crypto"
subPackage "cli"

toolchainRequirements dmd=">=2.109.1" ldc=">=1.40.1" gdc="no"
