name "andaime"
description "Micro web framework in D: FastAPI-style ergonomics, dispatch generated at compile time"
authors "Leonardo Tada Antunes"
copyright "Copyright © 2026, leotada"
license "MIT"
homepage "https://github.com/leotada/andaime"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "andaime:http" version="*"
dependency "andaime:web" version="*"
dependency "andaime:engine" version="*"
subPackage "http"
subPackage "web"
subPackage "engine"
subPackage "jobs"
subPackage "crypto"
subPackage "cli"
subPackage "drivers/pg"
subPackage "drivers/pgjobs"

toolchainRequirements dmd=">=2.112.0" ldc=">=1.42.0" gdc="no"
